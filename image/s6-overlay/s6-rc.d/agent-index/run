#!/command/with-contenv sh
# Report usage without passing the broad Plow bearer to normal report calls.
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH AGENT_ID
HERMES_HOME=/var/lib/hermes
export HERMES_HOME

client() {
  /command/s6-setuidgid hermes env -i \
    PATH="$PATH" HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" \
    AGENT_ID="$AGENT_ID" PLOW_API_BASE="$PLOW_API_BASE" ${TZ:+TZ="$TZ"} \
    "$@"
}

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: AGENT_ID is unset; standing down" >&2
  exec /bin/sleep 86400
fi

while :; do
  client /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py status >/dev/null
  case $? in
    0) ;;
    3)
      bearer_name=PLOW_AGENT_TOKEN
      client env "$bearer_name=$PLOW_AGENT_TOKEN" \
        /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
        --register --agent "$AGENT_ID" >/dev/null || {
          echo "agent-index: registration failed; retrying later" >&2
          /bin/sleep 300
          continue
        }
      ;;
    *)
      echo "agent-index: state unreadable; refusing to register over it" >&2
      /bin/sleep 300
      continue
      ;;
  esac

  client /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
    || echo "agent-index: report failed; retrying later" >&2
  /bin/sleep 300
done
